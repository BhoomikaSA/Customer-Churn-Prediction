# Ignore virtual environment
.venv/
venv/
ENV/

# Ignore Python cache files & build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
dist/
build/

# Ignore Jupyter notebook checkpoints
.ipynb_checkpoints/

# Include models directory & artifacts (small < 6MB)
# models/*.joblib line removed to ensure best_model_pipeline.joblib is tracked

# Ignore temporary processed data if generated, keep data/raw/
data/processed/*
!data/processed/.gitkeep

# Ignore IDE settings & OS temp files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Ignore environment & secret files
.env
.env.local
*.log
